# KSF Podfile - Podman equivalent of Dockerfile
# Build: podman build -t localhost/ksf-fa:php7.4 -f Podfile .
#
# Note: The FA source tree is NOT baked into the image. It is mounted
# read-only at /var/www/html at instantiation time from
# <infra>/FA/2.4.3, with fa_modules mounted at /var/www/html/modules and
# the per-pod editable files (config_db.php, installed_extensions.php,
# company/) mounted from <infra>/FA/<pod>/.

FROM docker.io/php:7.4-apache

LABEL maintainer="KSF Development Team"
LABEL description="FrontAccounting runtime (PHP 7.4, FA code mounted at runtime)"

# Install PHP extensions required by FA 2.4.x
RUN apt-get update --allow-releaseinfo-change -o Acquire::Check-Valid-Until=false && \
    apt-get install -y --no-install-recommends \
        libpng-dev libjpeg-dev libfreetype-dev libzip-dev && \
    docker-php-ext-configure gd --with-freetype --with-jpeg && \
    docker-php-ext-install mysqli gd zip && \
    rm -rf /var/lib/apt/lists/*

# Enable Apache module required by FA
RUN a2enmod rewrite

# KSF PHP settings (memory, uploads, session hardening)
COPY php.ini /usr/local/etc/php/conf.d/zz-ksf.ini

# KSF runtime permission fixer (idempotent; runs on every container start).
# Fixes bind-mounted writable paths for www-data under rootless podman.
COPY entrypoint.sh /usr/local/bin/ksf-entrypoint.sh
RUN chmod +x /usr/local/bin/ksf-entrypoint.sh

EXPOSE 80

ENTRYPOINT ["/usr/local/bin/ksf-entrypoint.sh"]
CMD ["apache2-foreground"]