{
    "name": "ksfraser/import-staging",
    "description": "Unified staging tables and processing pipeline for third-party imports into FrontAccounting (WooCommerce, Square API, Square CSV, PayPal, Bank Import)",
    "type": "fa-module",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Kevin Fraser",
            "email": "kevin@ksfraser.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "7.4.33"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "vendor/ksfraser/famock",
            "canonical": false
        },
        {
            "type": "vcs",
            "url": "https://github.com/ksfraser/Traits.git"
        }
    ],
    "require": {
        "php": ">=7.3",
        "ext-json": "*",
        "ksfraser/ksf-modules-dao": "^0.3",
        "ksfraser/contact-dto": "^0.1",
        "ksfraser/staging-dto": "^0.0.1",
        "ksfraser/file": "dev-main",
        "ksfraser/traits": "dev-main",
        "ksfraser/exceptions": "^1.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "ksfraser/famock": "^0.10"
    },
    "autoload": {
        "psr-4": {
            "ksfraser\\FrontAccounting\\ImportStaging\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ksfraser\\FrontAccounting\\ImportStaging\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage/"
    },
    "extra": {
        "fa-module": {
            "name": "Import Staging Processing",
            "description": "Unified staging and processing for post-import operations",
            "page": "ksf_import_staging.php",
            "version": "0.1.0",
            "depends": ["ksf_ModulesDAO", "ksf_libs"]
        }
    }
}
