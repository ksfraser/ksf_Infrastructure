# KSF UAT Environment Configuration
# Copy this file to .env and customize values

# MariaDB Configuration
MARIADB_ROOT_PASSWORD=ksfroot2024!
MARIADB_DATABASE=ksf_fa
MARIADB_USER=ksf_user
MARIADB_PASSWORD=ksfuser2024!

# Port Configuration (set via inventory or here)
FA_PORT=8090
WP_PORT=8091

# Application URLs (auto-generated from ports)
FA_URL=http://localhost:${FA_PORT}
WP_URL=http://localhost:${WP_PORT}

# Admin credentials
FA_ADMIN_USER=admin
FA_ADMIN_PASSWORD=admin
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin2024!

# Optional: Override auto-detected FQDN/IP
# KSF_URL=192.168.1.100