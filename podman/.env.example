# KSF UAT Environment Configuration
# Copy this file to .env and customize values

# MariaDB Configuration
MARIADB_ROOT_PASSWORD=ksfroot2024!
MARIADB_DATABASE=ksf_fa
MARIADB_USER=ksf_user
MARIADB_PASSWORD=ksfuser2024!

# Port Configuration (set via inventory or here)
FA_PORT=8090
WP_PORT=8091

# Volume prefix (for data persistence uniqueness)
VOLUME_PREFIX=ksf_infrastructure

# Application URLs (auto-generated from ports)
FA_URL=http://localhost:${FA_PORT}
WP_URL=http://localhost:${WP_PORT}

# Admin credentials
FA_ADMIN_USER=admin
FA_ADMIN_PASSWORD=admin
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin2024!

# Optional: Override auto-detected FQDN/IP
# KSF_URL=192.168.1.100

# Optional: KSF Stock Market Python Worker (mounted from ksf_stockmarket repo)
# Enable with ansible var: enable_stockmarket_python_worker=true
# Or enable profile manually with podman-compose --profile stockmarket
STOCKMARKET_PYTHON_DIR=/home/ksf_stockmarket/ksf_stockmarket/python
STOCKMARKET_WORKER_PORT=8000
ENABLE_PYTHON_CONTAINER=0

# ---------------------------------------------------------------------------
# DB sync container (local MariaDB -> webhost clone / offsite backup)
# Option A: nightly full dump  -> webhost (clean refresh + offsite backup).
# Option B: intraday outbox delta sync -> webhost (near-real-time).
# The db-sync container reads these. Put REAL values in .env (gitignored),
# never in this committed template.
# ---------------------------------------------------------------------------
# Webhost (CPanel MariaDB) connection — the clone / backup target
WEBHOST_DB_HOST=db.your-webhost.example.com
WEBHOST_DB_PORT=3306
WEBHOST_DB_NAME=ksf_fa
WEBHOST_DB_USER=ksf_user
WEBHOST_DB_PASS=change_me_webhost_password

# Sync tuning
SYNC_BATCH_SIZE=2000
SYNC_MAX_ATTEMPTS=10
BACKUP_RETAIN_DAYS=7
TZ=America/Toronto
