<?php
/* Per-pod wp-config.php - ksf.wordpress role.
   DB connection is taken from container env vars (WORDPRESS_DB_*), the same
   contract the official wordpress image uses, so the wp-cli seeding container
   works against this file verbatim. */

if ( !defined( 'ABSPATH' ) ) {
	define( 'ABSPATH', __DIR__ . '/' );
}

// ** MySQL settings **
define( 'DB_NAME',     getenv( 'WORDPRESS_DB_NAME' ) ?: '{{ wp_db }}' );
define( 'DB_USER',     getenv( 'WORDPRESS_DB_USER' ) ?: '{{ wp_db_user }}' );
define( 'DB_PASSWORD', getenv( 'WORDPRESS_DB_PASSWORD' ) ?: '{{ wp_db_pass }}' );
define( 'DB_HOST',     getenv( 'WORDPRESS_DB_HOST' ) ?: '{{ wp_mariadb_host }}:3306' );
define( 'DB_CHARSET',  'utf8mb4' );
define( 'DB_COLLATE',  '' );

$table_prefix = getenv( 'WORDPRESS_TABLE_PREFIX' ) ?: '{{ wp_table_prefix }}';

// ** URLs - settable per pod for troubleshooting **
{% if wp_home | length > 0 %}define( 'WP_HOME', '{{ wp_home }}' );{% endif %}
{% if wp_site_url | length > 0 %}define( 'WP_SITEURL', '{{ wp_site_url }}' );{% endif %}

// ** Debug / troubleshooting switches **
{% if wp_debug | bool %}define( 'WP_DEBUG', true );
{% endif %}{% if wp_debug_log | bool %}define( 'WP_DEBUG_LOG', true );
{% endif %}{% if wp_debug_display | bool %}define( 'WP_DEBUG_DISPLAY', true );
{% endif %}{% if wp_savequeries | bool %}define( 'SAVEQUERIES', true );
{% endif %}{% if wp_error_reporting | length > 0 %}
error_reporting( {{ wp_error_reporting }} );
{% endif %}

// ** Authentication unique keys and salts (per-pod static) **
define( 'AUTH_KEY',         '{{ wp_auth_key | default(wp_salt) }}' );
define( 'SECURE_AUTH_KEY',  '{{ wp_secure_auth_key | default(wp_salt) }}' );
define( 'LOGGED_IN_KEY',    '{{ wp_logged_in_key | default(wp_salt) }}' );
define( 'NONCE_KEY',        '{{ wp_nonce_key | default(wp_salt) }}' );
define( 'AUTH_SALT',        '{{ wp_auth_salt | default(wp_salt) }}' );
define( 'SECURE_AUTH_SALT', '{{ wp_secure_auth_salt | default(wp_salt) }}' );
define( 'LOGGED_IN_SALT',   '{{ wp_logged_in_salt | default(wp_salt) }}' );
define( 'NONCE_SALT',       '{{ wp_nonce_salt | default(wp_salt) }}' );

// ** Absolute path + stop editing **
if ( !defined( 'ABSPATH' ) ) {
	define( 'ABSPATH', __DIR__ . '/' );
}
require_once ABSPATH . 'wp-settings.php';