# KSF Infrastructure - Local Development Inventory
# Usage: ansible-playbook -i inventories/local ksf-playbook.yaml

localhost ansible_connection=local ansible_python_interpreter=/usr/bin/python3

[ksf:vars]
# Port configuration
fa_port=8090
wp_port=8091

# Volume prefix (for data persistence uniqueness)
volume_prefix=ksf_infrastructure

# Database configuration
mariadb_root_pass=ksfroot2024!
mariadb_db=ksf_fa

# FA Modules to deploy (from /home/kevin/Documents/)
fa_modules:
