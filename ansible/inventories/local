# KSF Infrastructure - Local Development Inventory
# Usage: ansible-playbook -i inventories/local ksf-playbook.yaml --ask-vault-pass
#
# Credentials come from group_vars/all/vault.yml (ansible-vault encrypted).
# See group_vars/all/vault.yml.example for the required structure.

localhost ansible_connection=local ansible_python_interpreter=/usr/bin/python3

[ksf:vars]
# Port configuration
fa_port=8090
wp_port=8091

# Volume prefix (for data persistence uniqueness)
volume_prefix=ksf_infrastructure

# Database name (non-sensitive)
mariadb_db=ksf_fa

# GitHub org for module repos
module_github_org=ksfraser
module_branch=main

# FA Modules to deploy — each must have a GitHub repo at:
#   https://github.com/<module_github_org>/<module_name>
fa_modules:
  - ksf_FA_Assets
  - ksf_FA_Subscriptions
  - ksf_FA_Service
  - ksf_FA_KnowledgeBase
  - ksf_FA_Fleet
  - ksf_FA_TravelExpense
  - ksf_FA_HRM
  - ksf_FA_ProjectManagement
  - ksf_FA_Timesheets
  - ksf_FA_Leave
  - ksf_FA_Onboarding
  - ksf_FA_Performance
  - ksf_FA_Recruitment
  - ksf_FA_Training
  - ksf_FA_OrgChart
  - ksf_FA_JobDescriptions
  - ksf_FA_Teams
  - ksf_FA_Roster
  - ksf_FA_Documents
  - ksf_FA_Forms
  - ksf_FA_EmailManager
  - ksf_FA_CampaignBuilder
  - ksf_FA_CRM
  - ksf_FA_Tracking
  - ksf_FA_Notes
  - ksf_FA_WarrantyManagement
  - ksf_FA_Workflow
  - ksf_FA_AsteriskPBX
  - ksf_FA_API
  - ksf_FA_Calendar
  - ksf_FA_DataIntegrity
  - ksf_fa_downloader
