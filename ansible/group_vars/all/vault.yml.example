# ansible/inventories/group_vars/all/vault.yml  (encrypted) — canonical vault.
# This example lives at ansible/group_vars/all/vault.yml.example (committed).
# It is inventory-relative so it loads regardless of import_playbook basedir.
#
# To create your vault:
#   cp group_vars/all/vault.yml.example inventories/group_vars/all/vault.yml
#   # Edit with real values
#   ansible-vault encrypt inventories/group_vars/all/vault.yml
#
# To edit an encrypted vault:
#   ansible-vault edit inventories/group_vars/all/vault.yml
#
# To run a playbook with vault:
#   ansible-playbook ... --ask-vault-pass
#   ansible-playbook ... --vault-password-file ~/.vault_pass   # never commit .vault_pass

---
vault_mariadb_root_pass: "CHANGE_ME_strong_root_password"
vault_mariadb_user: "ksf_user"
vault_mariadb_pass: "CHANGE_ME_strong_user_password"
# Per-environment default users seeded into FA + WP (edit per environment)
ksf_admin_user: "admin"
ksf_admin_pass: "CHANGE_ME_admin_password"
ksf_staff_user: "kevin"
ksf_staff_pass: "CHANGE_ME_staff_password"
ksf_staff_email: "kevin@ksfraser.ca"
# phpMyAdmin optional auto-login (leave blank to force manual login)
# phpmyadmin_user: ""
# phpmyadmin_password: ""