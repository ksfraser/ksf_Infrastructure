# pod-ksf_fa.service (rootless)
# The rootless pod owns the network namespace, the published ports and the
# lifecycle of its containers (FA + MariaDB). Name-based and idempotent, so a
# recreated pod does not invalidate the unit.

[Unit]
Description=Podman pod ksf_fa (FA + MariaDB, rootless)
Documentation=man:podman-pod-create(1)
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%t/containers

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Restart=on-failure
TimeoutStopSec=70
ExecStart=/bin/sh -c '/usr/bin/podman pod exists ksf_fa || /usr/bin/podman pod create --name ksf_fa --network ksf_network; /usr/bin/podman pod start ksf_fa'
ExecStop=/usr/bin/podman pod stop -t 10 ksf_fa
Type=oneshot
RemainAfterExit=yes

[Install]
WantedBy=default.target
