[Unit]
Description=KSF FrontAccounting post-boot reconcile and conditional repair
Documentation=file:/home/kevin/Documents/ksf_Infrastructure/ansible/systemd/ksf-boot-reconcile.sh
Wants=network-online.target
After=network-online.target container-ksfii_app-mariadb.service container-ksfii_app-fa.service container-ksfii_app-phpmyadmin.service container-ksfii_app-wordpress.service
RequiresMountsFor=/home/kevin/Documents

[Service]
Type=oneshot
RemainAfterExit=no
# Health-check both pods and rebuild only what is actually broken. A healthy
# stack is left alone: this unit must never churn a working deployment.
ExecStart=/usr/local/sbin/ksf-boot-reconcile.sh
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
